<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="view_account_payment_form_inherited">
        <field name="name">view.account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group2']//field[@name='journal_id']" position="after">
                <field name="method_payment_id"/>
            </xpath>
            <xpath expr="//group[@name='group2']//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="view_account_payment_tree_inherited">
        <field name="name">view.account.payment.tree.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="method_payment_id"/>
            </field>
            <xpath expr="//field[@name='payment_method_line_id']" position="replace"/>
        </field>
    </record>
</odoo>
