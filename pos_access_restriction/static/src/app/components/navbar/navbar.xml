<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_hr.Navbar" t-inherit="point_of_sale.Navbar"
       t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(text(), 'Close Register')]"
               position="attributes">
            <attribute name="t-if">
                !pos.config.module_pos_hr
                or pos.employeeIsAdmin
                or pos.getCashierUserId()?.id === pos.session.user_id?.id
                or pos.getCashier()._role !== "manager"
            </attribute>
        </xpath>
    </t>
</templates>
